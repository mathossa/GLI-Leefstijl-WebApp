# Example Portainer Stack environment; NEVER commit real values to Git.
# Pin both application images to the same commit/release, e.g. local image tags or registry digests.
APP_IMAGE=mijn-leefstijl:local
MIGRATOR_IMAGE=mijn-leefstijl-migrate:local

# An existing reverse-proxy Docker network, accessible from Portainer's Docker endpoint.
PROXY_NETWORK=reverse-proxy

# PostgreSQL 17 (internal only; no publicly exposed database port).
POSTGRES_USER=leefstijl
POSTGRES_DB=leefstijl
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD

# IMPORTANT: URL-encode special characters in the password, and use host 'postgres'.
DATABASE_URL=postgresql://leefstijl:REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD@postgres:5432/leefstijl
BETTER_AUTH_URL=https://leefstijl.example.nl
BETTER_AUTH_SECRET=REPLACE_WITH_A_NEW_RANDOM_32_BYTE_OR_LONGER_SECRET

# Optional, only after merging #6. Generate separately with: openssl rand -base64 32
SMTP_ENCRYPTION_KEY=
