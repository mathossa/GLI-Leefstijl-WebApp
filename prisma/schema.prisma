// Better Auth owns the identity models. Run `npm run db:generate` and
// `npx auth generate --yes --adapter prisma --dialect postgresql` when changing plugins.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  goals         Goal[]
  habitActions  HabitAction[]
  reflections   WeeklyReflection[]
  meetingNotes  MeetingNote[]
  meetingPhotos MeetingPhoto[]
  quotePreference UserQuotePreference?

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum GoalArea {
  BEWEGING
  VOEDING
  SLAAP
  ONTSPANNING
  SOCIAAL
  ANDERS
}

enum GoalStatus {
  ACTIVE
  ARCHIVED
}

model Goal {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String       @db.VarChar(120)
  motivation String       @db.VarChar(1000)
  progressIndicator String? @db.VarChar(500)
  area       GoalArea
  status     GoalStatus   @default(ACTIVE)
  startDate  DateTime?    @db.Date
  endDate    DateTime?    @db.Date
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  actions    HabitAction[]

  // Composite ownership is enforced by the DB for child actions.
  @@unique([id, userId])
  @@index([userId, status])
  @@map("goal")
}

model HabitAction {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId        String
  goal          Goal                @relation(fields: [goalId, userId], references: [id, userId], onDelete: Cascade)
  title         String              @db.VarChar(120)
  targetPerWeek Int
  whenContext       String? @db.VarChar(250)
  confidenceScore   Int?
  existingStrength  String? @db.VarChar(500)
  confidenceBooster String? @db.VarChar(500)
  obstacle          String? @db.VarChar(500)
  fallbackPlan      String? @db.VarChar(500)
  archivedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  weeks         HabitWeekProgress[]

  @@unique([id, userId])
  @@index([userId, goalId])
  @@map("habit_action")
}

model HabitWeekProgress {
  id             String      @id @default(cuid())
  userId         String
  actionId       String
  action         HabitAction @relation(fields: [actionId, userId], references: [id, userId], onDelete: Cascade)
  weekStart      DateTime    @db.Date
  targetCount    Int
  completedCount Int         @default(0)
  note           String?     @db.VarChar(500)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  entries        HabitWeekEntry[]

  // Each ISO/Amsterdam week has an independent immutable target snapshot.
  @@unique([id, userId])
  @@unique([actionId, weekStart])
  @@index([userId, weekStart])
  @@map("habit_week_progress")
}

// A single quick tap creates one entry; feedback can be added independently.
// Legacy weekly totals are retained even when no individual entries exist.
model HabitWeekEntry {
  id         String            @id @default(cuid())
  userId     String
  weekId     String
  week       HabitWeekProgress @relation(fields: [weekId, userId], references: [id, userId], onDelete: Cascade)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  rating     String?           @db.VarChar(12)
  note       String?           @db.VarChar(500)

  @@index([userId, weekId, createdAt])
  @@map("habit_week_entry")
}
// Personal reflections are private to one user and one Amsterdam calendar week.
model WeeklyReflection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date
  wentWell  String   @default("") @db.VarChar(1500)
  difficult String   @default("") @db.VarChar(1500)
  nextStep  String   @default("") @db.VarChar(1500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([userId, weekStart(sort: Desc)])
  @@map("weekly_reflection")
}

model MeetingNote {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingDate  DateTime @db.Date
  title        String   @db.VarChar(120)
  notes        String   @db.VarChar(4000)
  actionPoints String?  @db.VarChar(2000)
  photos       MeetingPhoto[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([id, userId])
  @@index([userId, meetingDate(sort: Desc)])
  @@map("meeting_note")
}

// Photos are held in a private server directory, never in /public.
// Metadata is owned by the same user as its CooL meeting.
model MeetingPhoto {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   MeetingNote @relation(fields: [meetingId, userId], references: [id, userId], onDelete: Cascade)
  fileName  String      @db.VarChar(120)
  createdAt DateTime    @default(now())

  @@index([userId, meetingId])
  @@map("meeting_photo")
}

// Only one server-side SMTP relay configuration is active for the whole app.
model AdminMailSettings {
  id                String   @id @default("smtp")
  enabled           Boolean  @default(false)
  host              String   @default("") @db.VarChar(253)
  port              Int      @default(587)
  security          String   @default("STARTTLS") @db.VarChar(10)
  username          String?  @db.VarChar(254)
  encryptedPassword String?  @db.Text
  fromName          String   @default("") @db.VarChar(120)
  fromEmail         String   @default("") @db.VarChar(254)
  lastTestAt        DateTime?
  updatedById       String?
  updatedAt         DateTime @updatedAt

  @@map("admin_mail_settings")
}

// No SMTP credentials, message bodies or personal health data in this audit.
model AdminAudit {
  id        String   @id @default(cuid())
  actorId   String
  action    String   @db.VarChar(80)
  targetId  String?  @db.VarChar(128)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("admin_audit")
}


 // Shared quote library. The starter seed is inserted by migration; admins maintain it afterwards.
model MotivationQuote {
  id        String   @id @db.VarChar(40)
  text      String   @db.VarChar(300)
  normalizedText String @unique @db.VarChar(300)
  category  String?  @db.VarChar(30)
  isActive  Boolean  @default(true)
  deletedAt DateTime?
  origin    String   @default("SEED") @db.VarChar(16)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("motivation_quote")
}

// Snapshots preserve a whole Amsterdam calendar day's quote across edits and restarts.
model DailyMotivationQuote {
  day       DateTime @id @db.Date
  quoteId   String?  @db.VarChar(40)
  text      String   @db.VarChar(300)
  createdAt DateTime @default(now())

  @@map("daily_motivation_quote")
}

// Personal custom text is private to its owner and independent from the shared library.
model UserQuotePreference {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode       String   @default("AUTO") @db.VarChar(6)
  customText String?  @db.VarChar(300)
  updatedAt  DateTime @updatedAt

  @@map("user_quote_preference")
}
