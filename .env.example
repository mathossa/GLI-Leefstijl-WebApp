# Copy to .env and replace all placeholder values. Never commit .env.
POSTGRES_USER=leefstijl
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
POSTGRES_DB=leefstijl
POSTGRES_PORT=5432
DATABASE_URL=postgresql://leefstijl:REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD@127.0.0.1:5432/leefstijl
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_32_BYTE_OR_LONGER_SECRET

# Optioneel: pas nodig voor het versleuteld opslaan van SMTP-credentials in /admin.
# Houd deze key altijd apart van BETTER_AUTH_SECRET en buiten de database.
# Genereer: openssl rand -base64 32
SMTP_ENCRYPTION_KEY=REPLACE_WITH_A_NEW_BASE64_32_BYTE_KEY

